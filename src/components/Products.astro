---
import Card from './Card.astro';
import i18next, { t } from "i18next";

const data = [
  {
    title: t("productos.title4"),
    description: t("productos.desc4"),
    imageUrl: "/img/Products/CasaHelene.jpg",
    videoUrl: "https://drive.google.com/file/d/16UI6LUdmMZP6DQPcCYtQVQgAC_A0Q-z7/preview"
  },
  {
    title: t("productos.title3"),
    description: t("productos.desc3"),
    imageUrl: "/img/Products/VillasMargarita.jpg",
    videoUrl: "https://drive.google.com/file/d/1_uzVc7W-o0H1UG9NKv-U_dFciphYSOpV/preview"
  },
  {
    title: t("productos.title1"),
    description: t("productos.desc1"),
    imageUrl: "/img/Products/Lotes.jpg",
    videoUrl: "https://drive.google.com/file/d/1c2HTTqezggUf_n3ImTFdZ6QRvhVdVlmj/preview"
  }
];
---

<style>
  .background-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/img/Products/VillasArcoiris.jpg');
    background-size: cover;
    background-position: center;
    z-index: -1;
    transition: background-image 0.5s ease-in-out;
  }

  .content-container {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.8), rgba(247, 243, 233, 0.8));
    z-index: 0;
  }

  .content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
  }

  h1 {
    color: black;
    text-align: center;
    margin-bottom: 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    justify-items: center;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
  }

  #videoModal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
  }

  #videoModal .modal-overlay {
    position: absolute;
    inset: 0;
    background: black;
    opacity: 0.75;
  }

  #videoModal .modal-content {
    position: relative;
    z-index: 50;
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    max-width: 800px;
    width: 90%;
    padding: 1.5rem;
    text-align: center;
  }

  #videoModal iframe {
    width: 100%;
    height: 400px;
    border: none;
  }

  #videoModal .close-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }
</style>

<div id="MODELOS">
  <div id="backgroundContainer" class="background-container"></div>

  <div class="content-container">
    <div class="content-overlay"></div>
    <div class="content">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold">
        {t("productos.title")}
      </h1>
      <div class="grid">
        {data.map((item, index) => (
          <div id={`card-${index}`} class="card">
            <Card
              title={item.title}
              description={item.description}
              imageUrl={item.imageUrl}
              videoUrl={item.videoUrl}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<!-- Modal para los videos -->
<div id="videoModal" class="fixed inset-0 hidden flex items-center justify-center">
  <div class="modal-overlay absolute inset-0 bg-black opacity-75"></div>
  <div class="modal-content relative bg-white rounded-lg shadow-lg max-w-2xl w-full p-4">
    <button class="close-button absolute top-2 right-2 text-2xl" id="closeButton">&times;</button>
    <iframe id="modalVideo" class="w-full h-80" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  </div>
</div>

<script>
  function openModal(videoUrl) {
    console.log("openModal llamado con:", videoUrl);
    const modal = document.getElementById('videoModal');
    const iframe = document.getElementById('modalVideo');

    if (modal && iframe) {
      iframe.src = videoUrl;
      modal.style.display = 'flex';
    } else {
      console.error("Modal o iframe no encontrado");
    }
  }

  function closeModal() {
    const modal = document.getElementById('videoModal');
    const iframe = document.getElementById('modalVideo');

    if (modal && iframe) {
      iframe.removeAttribute('src'); // Limpiar el src para detener el video
      modal.style.display = 'none';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    console.log("Script cargado correctamente");
    
    const backgroundContainer = document.getElementById('backgroundContainer');

    if (backgroundContainer) {
      document.querySelectorAll('.card').forEach((card, index) => {
        const imageUrl = card.querySelector('img')?.src;

        if (imageUrl) {
          card.addEventListener('mouseover', () => {
            backgroundContainer.style.backgroundImage = `url(${imageUrl})`;
          });
        }
      });
    }

    // Vincular eventos a los botones
    document.querySelectorAll('.card button').forEach(button => {
      button.addEventListener('click', () => {
        const videoUrl = button.getAttribute('data-video-url');
        if (videoUrl) {
          openModal(videoUrl);
        }
      });
    });

    // Cerrar modal al hacer clic fuera del contenido
    const modalOverlay = document.querySelector('#videoModal .modal-overlay');
    if (modalOverlay) {
      modalOverlay.addEventListener('click', closeModal);
    }

    // Asegurarse de que el botón de cierre funcione correctamente
    const closeButton = document.getElementById('closeButton');
    if (closeButton) {
      closeButton.addEventListener('click', closeModal);
    }
  });
</script>
